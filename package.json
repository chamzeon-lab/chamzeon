    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
